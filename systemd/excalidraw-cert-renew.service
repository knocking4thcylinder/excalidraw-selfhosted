[Unit]
Description=Renew Excalidraw TLS certificate
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=oneshot
User=@USER@
Environment="HOME=@HOME@" "PATH=@HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin" "FQDN=@FQDN@"
ExecStart=/bin/bash @BASE@/deploy.sh renew-cert
