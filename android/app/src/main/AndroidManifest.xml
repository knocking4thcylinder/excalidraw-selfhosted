<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.k4c.excalidraw"
    android:versionCode="4"
    android:versionName="1.3">

    <!-- HarmonyOS 2.0 is Android 10 (API 29); minSdk 21 covers older too -->
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34"/>

    <!-- HTTPS only -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- legacy (Android <10) fallback path for blob exports -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
                     android:maxSdkVersion="28"/>

    <application
        android:label="Excalidraw"
        android:icon="@drawable/ic_launcher"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
        android:usesCleartextTraffic="false">

        <activity android:name=".MainActivity"
                  android:exported="true"
                  android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="steamdeck.example.ts.net"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
